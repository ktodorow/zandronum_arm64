FROM debian@sha256:d07d1b51c39f51188e60be9b64e6bf769fa94e187f092bc32b91305cfa34ba5a AS build

RUN rm /etc/apt/sources.list.d/debian.sources && \
    printf '%s\n' \
      'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/20261014T000000Z/ trixie main' \
      'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian-security/20261014T000000Z/ trixie-security main' \
      > /etc/apt/sources.list && \
    apt-get -o Acquire::Retries=3 update && \
    apt-get install -y --no-install-recommends g++=4:14.2.0-1 pkg-config libsdl2-dev binutils && \
    mkdir -p /export/evidence

COPY tools/r36s/launcher /source
RUN g++ -std=c++17 -O2 -Wall -Wextra -Werror -march=armv8-a -mtune=cortex-a35 \
        /source/content.cpp /source/test-content.cpp -o /test-content && \
    /test-content > /export/evidence/tests.log && \
    g++ -std=c++17 -O2 -Wall -Wextra -Werror -march=armv8-a -mtune=cortex-a35 \
        /source/content.cpp /source/test-ui.cpp $(pkg-config --cflags --libs sdl2) -o /test-ui && \
    SDL_VIDEODRIVER=dummy SDL_RENDER_DRIVER=software /test-ui > /export/evidence/menu-tests.log && \
    g++ -std=c++17 -O2 -Wall -Wextra -Werror -march=armv8-a -mtune=cortex-a35 \
        /source/content.cpp /source/main.cpp $(pkg-config --cflags --libs sdl2) -o /export/r36s-launcher && \
    strip /export/r36s-launcher && \
    mkdir -p /fixture/iwads /fixture/mods && \
    printf 'IWAD' > /fixture/iwads/doom2.wad && \
    printf 'PWAD' > '/fixture/mods/Map pack.wad' && \
    SDL_VIDEODRIVER=dummy SDL_RENDER_DRIVER=software /export/r36s-launcher \
        --game-dir /fixture --output /fixture/selection --capture /export/evidence/home.bmp && \
    readelf -h /export/r36s-launcher > /export/evidence/launcher.elf.txt && \
    readelf -d /export/r36s-launcher > /export/evidence/launcher.dynamic.txt && \
    dpkg-query -W -f='${Package}\t${Version}\t${Architecture}\n' > /export/evidence/launcher-packages.tsv

FROM scratch AS artifacts
COPY --from=build /export/ /
